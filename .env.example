# ==============================================================================
# APLIKASI WEB KATALOG UNDANGAN PERNIKAHAN
# Konfigurasi Environment & Produksi
# ==============================================================================

# --- IDENTITAS APLIKASI ---
APP_NAME="Katalog Undangan"
APP_ENV=production
APP_KEY=
# PERHATIAN: Di lingkungan produksi (Production), pastikan APP_DEBUG=false untuk mencegah kebocoran informasi kredensial & database!
APP_DEBUG=false
APP_URL=https://katalogundangan.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- DATABASE (MYSQL REKOMENDASI PRODUKSI) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=katalog_undangan
DB_USERNAME=root
DB_PASSWORD=

# --- SESSION & CACHE ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Cache store: 'database' atau 'redis' (disarankan redis/file untuk kecepatan tinggi)
CACHE_STORE=database

# --- QUEUE & FILESYSTEM ---
QUEUE_CONNECTION=database
# PENTING: FILESYSTEM_DISK harus 'public' agar gambar produk, galeri, dan banner dapat diakses via web
FILESYSTEM_DISK=public

# --- INTEGRASI WHATSAPP ADMIN (WAJIB FORMAT INTERNASIONAL TANPA TANDA +) ---
# Contoh: 6281234567890 (Gunakan kode negara 62 untuk Indonesia)
WHATSAPP_ADMIN_NUMBER=6281234567890

# --- SEEDER PRODUKSI (Digunakan saat menjalankan: php artisan db:seed --class=ProductionSeeder) ---
# PERINGATAN: Ganti kredensial admin default ini sebelum menjalankan deployment publik!
ADMIN_DEFAULT_EMAIL=admin@katalogundangan.com
ADMIN_DEFAULT_PASSWORD=AdminSecure2026!

# --- PENGATURAN EMAIL (SMTP / NOTIFIKASI) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="halo@katalogundangan.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- ASSET COMPILATION (VITE) ---
VITE_APP_NAME="${APP_NAME}"

# --- GOOGLE OAUTH LOGIN ---
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

